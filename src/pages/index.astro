---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Goals from '../components/Goals.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Packages from '../components/Packages.astro';
import Results from '../components/Results.astro';
import About from '../components/About.astro';
import LeadMagnet from '../components/LeadMagnet.astro';
import Faq from '../components/Faq.astro';
import Booking from '../components/Booking.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import MobileCta from '../components/MobileCta.astro';
---
<Layout>
