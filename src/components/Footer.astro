---
import { site } from '../data/site';
---
<footer id="footer" class="border-t border-line pb-28 pt-14 md:pb-10">
  <div class="container-x flex flex-wrap justify-between gap-8">
    <div class="flex flex-col gap-2.5">
      <div class="font-display text-[28px]">{site.brand} <span class="text-accent">{site.brandAccent}</span></div>
      <p class="text-[15px] text-subtle">Personalni trening · {site.city} &amp; online</p>
    </div>
    <div class="flex flex-col gap-2 text-[15px]">
      <a href={site.instagram} class="text-accent hover:text-accent-hover" target="_blank" rel="noopener">Instagram</a>
      <a href={site.tiktok} class="text-accent hover:text-accent-hover" target="_blank" rel="noopener">TikTok</a>
      <a href={`https://wa.me/${site.whatsapp}`} class="text-accent hover:text-accent-hover" target="_blank" rel="noopener">WhatsApp</a>
    </div>
    <div class="flex flex-col gap-2 text-[15px] text-muted">
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <span>{site.phone}</span>
      <span>{site.gymAddress}</span>
    </div>
  </div>
  <p class="container-x mt-10 text-[13px] leading-relaxed text-subtle">
    Planovi ishrane su opšte smjernice i ne zamjenjuju savjet ljekara ili nutricioniste. © {new Date().getFullYear()} {site.brand} {site.brandAccent}
  </p>
</footer>
