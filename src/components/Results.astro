---
import { reviews } from '../data/site';
---
<section id="rezultati" class="container-x flex flex-col gap-10 py-20 md:py-24">
  <h2 class="split-reveal h-display text-5xl md:text-[56px]">Rezultati klijenata</h2>
  <div class="grid gap-5 md:grid-cols-3">
    {reviews.map((r, i) => (
      <figure class="reveal flex flex-col overflow-hidden rounded-2xl bg-ink-2" style={`--d:${i * 0.1}s`}>
        <div class="grid h-56 grid-cols-2">
          <div class="placeholder-img border-0">[PRIJE]</div>
          <div class="placeholder-img border-0 bg-[#23251C]">[POSLIJE]</div>
        </div>
        <figcaption class="flex flex-col gap-2.5 p-6">
          <blockquote class="leading-relaxed">{r.quote}</blockquote>
          <span class="text-sm text-subtle">{r.who} – <span class="text-accent">{r.result}</span></span>
        </figcaption>
      </figure>
    ))}
  </div>
</section>
