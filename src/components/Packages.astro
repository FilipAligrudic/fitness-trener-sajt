---
import { packages } from '../data/site';
---
<section id="paketi" class="bg-ink-2 py-20 md:py-24">
  <div class="container-x flex flex-col gap-10">
    <div class="reveal flex flex-col items-center gap-3 text-center">
      <p class="eyebrow">Paketi</p>
      <h2 class="split-reveal h-display text-5xl md:text-[56px]">Izaberi svoj nivo</h2>
    </div>
    <div class="grid items-stretch gap-5 lg:grid-cols-3">
      {packages.map((p, i) => (
        <article class:list={['reveal lift flex flex-col gap-5 rounded-3xl bg-ink p-8', p.featured ? 'border-2 border-accent lg:-translate-y-3' : 'border border-line']} style={`--d:${i * 0.1}s`}>
          <div class="flex items-center justify-between gap-3">
            <h3 class="h-display text-[32px]">{p.name}</h3>
            {p.featured && <span class="rounded-full bg-accent px-3 py-1.5 text-[13px] font-bold text-ink">Najpopularniji</span>}
          </div>
          <div>
            <div class="text-[40px] font-bold">{p.price} €</div>
            <p class="text-[15px] text-subtle">{p.period}</p>
          </div>
          <ul class="flex flex-col gap-2.5 text-base text-muted">
            {p.features.map((f) => (
              <li class="flex gap-3">
                <svg aria-hidden="true" class="mt-1 shrink-0 text-accent" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5l3 3 7-7"/></svg>
                {f}
              </li>
            ))}
          </ul>
          <a href={`#kontakt`} data-package={p.id} class={p.featured ? 'btn-primary mt-auto' : 'btn-ghost mt-auto'}>Izaberi {p.name}</a>
        </article>
      ))}
    </div>
  </div>
</section>
