---
import { faq } from '../data/site';
---
<section class="mx-auto flex max-w-3xl flex-col px-5 pb-20 md:pb-24">
  <h2 class="split-reveal h-display mb-6 text-5xl">Česta pitanja</h2>
  {faq.map((f) => (
    <details class="reveal group border-b border-line py-5">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-semibold">
        {f.q}
        <span aria-hidden="true" class="text-2xl text-accent transition-transform group-open:rotate-45">+</span>
      </summary>
      <p class="mt-3 leading-relaxed text-muted">{f.a}</p>
    </details>
  ))}
</section>
